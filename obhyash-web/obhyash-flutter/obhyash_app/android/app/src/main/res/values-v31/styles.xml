<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) Launch Theme — Light Mode -->
    <!-- Uses the new SplashScreen API: matching brand background and transparent icon
         so Flutter SplashView entrance animation starts seamlessly without a flash/blink -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Splash background: matches Flutter SplashView _deepestGreen (#071500) -->
        <item name="android:windowSplashScreenBackground">#071500</item>
        <!-- Transparent icon eliminates double-splash blinking before Flutter entrance animation -->
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- Legacy window background (used until Flutter draws its first frame) -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
